# Telecom Network Troubleshooting AI - Environment Variables Template
# Copy this file to .env and fill in your values

# Groq API Configuration (REQUIRED)
GROQ_API_KEY=your_groq_api_key_here

# API Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501"]
ENVIRONMENT=development
# Streamlit-to-FastAPI URL (including /api/v1)
API_BASE_URL=http://localhost:8000/api/v1

# Authentication (required to enable registration and login)
# Set a unique random value of at least 32 bytes. Keep it private.
JWT_SECRET_KEY=
# Use a separate unique random value of at least 32 bytes; never reuse JWT_SECRET_KEY.
AUDIT_IDENTIFIER_HMAC_SECRET=
JWT_ACCESS_TOKEN_MINUTES=60
BCRYPT_ROUNDS=12
LOGIN_IP_MAX_FAILURES=20
LOGIN_ACCOUNT_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_ACCOUNT_LOCKOUT_SECONDS=900

# Email Verification (required for registration and login)
# Local development can use a local SMTP capture service such as Mailpit:
# SMTP_HOST=127.0.0.1, SMTP_PORT=1025, SMTP_USE_TLS=false
# SMTP_FROM_EMAIL=no-reply@localhost, FRONTEND_BASE_URL=http://localhost:8501
# No SMTP credentials are needed for a local Mailpit instance.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
FRONTEND_BASE_URL=
EMAIL_VERIFICATION_MINUTES=20
VERIFICATION_EMAIL_IP_MAX_PER_HOUR=10
VERIFICATION_EMAIL_ADDRESS_MAX_PER_HOUR=3
PASSWORD_RESET_MINUTES=30

# Groq LLM Configuration
LLM_MODEL=llama-3.1-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# HuggingFace BGE Embedding Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu

# Vector Store Configuration
CHROMA_PERSIST_DIR=./storage/chroma
CHROMA_COLLECTION_NAME=telecom_manuals

# Document Ingestion Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DATA_DIR=./data/manuals

# Retrieval Configuration
TOP_K=5
SIMILARITY_THRESHOLD=0.7

# Evaluation Configuration
EVAL_QUESTIONS_FILE=./evaluation/test_questions.json